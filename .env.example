# ─────────────────────────────────────────────────────────────
# Inverge API — environment template
#
# Copy to `.env` for local development. Never commit `.env`.
# Every variable here is read by `src/config/env.validation.ts` (zod) at boot;
# a missing required value stops the process with the variable's NAME, never
# its value. Defaults below match that schema.
#
# Production profile on Render: see docs/deployment/render.md.
# ─────────────────────────────────────────────────────────────

# ── App ────────────────────────────────────────────────────────
# Use `production` on any internet-facing deployment. It changes log format,
# Secure cookies at the web layer, production-only safety checks, and removes
# the localhost CORS allowance. `test` is for the e2e harness.
NODE_ENV=development
# Render injects PORT. Locally the API must not share port 3000 with the web app.
PORT=3000

# ── Database (Postgres, Prisma v7 driver adapter) ─────────────────────────────
# Required. No default.
DATABASE_URL=postgresql://inverge:inverge@localhost:5432/inverge?schema=public
# Optional: direct (non-pooled) URL used by migrations behind a pooler.
# DIRECT_URL=postgresql://inverge:inverge@localhost:5432/inverge?schema=public

# ── Redis / BullMQ (optional infrastructure) ──────────────────────────────────
# Redis backs the shared cache, distributed rate limits and BullMQ queues. When
# disabled, reads fall back to Postgres and queues/schedulers are skipped. When
# enabled but unreachable, the `auth`, `financial` and `admin` rate-limit
# policies FAIL CLOSED (503); everything else uses a bounded local bucket.
REDIS_URL=redis://localhost:6379
# REDIS_ENABLED=true
# QUEUE_ENABLED=true

# ── HTTP, CORS and proxy ──────────────────────────────────────────────────────
# Comma-separated browser origins. Empty means same-origin only. The Inverge web
# app calls the API server-to-server, so it does NOT need an entry here. Add an
# origin only for a browser or mobile client that calls the API directly.
# CORS_ORIGINS=
# Number of reverse proxies in front of the API. Render terminates TLS in front
# of the service, so set 1 there. 0 trusts no forwarding header.
# TRUST_PROXY_HOPS=0
# JSON_BODY_LIMIT=1mb

# ── Rate limiting, metrics and logs ───────────────────────────────────────────
# RATE_LIMIT_ENABLED=true
# Prometheus scrape endpoint at /metrics (outside /api/v1). Default is enabled
# with NO token, which exposes metrics to anyone who can reach the service.
# Set a token on any public deployment. Send `Authorization: Bearer <token>`.
# METRICS_ENABLED=true
# METRICS_TOKEN=
# `json` in production, `pretty` elsewhere unless set explicitly.
# LOG_FORMAT=json
# LOG_LEVEL=log
# Salt used when hashing identifiers in logs. Set a deployment-specific value
# in production so log hashes are not portable between environments.
# LOG_HASH_SALT=inverge-log

# ── Session / auth ────────────────────────────────────────────────────────────
# HS256 secret for the one-hour session JWT. The API REFUSES TO BOOT when
# NODE_ENV=production and this is still the documented default. Generate 32+
# random bytes; never reuse it across environments.
SESSION_JWT_SECRET=change-me-in-production

# FR-901: comma-separated emails and/or provider user ids that always pass the
# AdminGuard. Use it to bootstrap the first admin, who then grants others via
# PATCH /api/v1/admin/users/:id/role. Keep empty if you do not need an admin yet.
ADMIN_ALLOWLIST=

# ── Provider selection (vendors are swappable; every port has a stub) ─────────
# Authentication, identity verification and payment adapters are security
# boundaries. NODE_ENV=production REFUSES TO BOOT with any of WALLET_PROVIDER,
# KYC_PROVIDER or FLATFEE_PROVIDER set to `stub` (audit F-01), and each stub also
# refuses every operation in production. Non-security ports may stay on the
# deterministic/offline adapter in staging.
#
# stub | privy | web3auth
WALLET_PROVIDER=stub
# stub | paystack  (paystack requires PAYSTACK_SECRET_KEY; production also
# requires PAYSTACK_WEBHOOK_SECRET)
FLATFEE_PROVIDER=stub
# stub | didit  (didit requires DIDIT_API_KEY; production also requires the
# webhook secret and all three workflow ids below)
KYC_PROVIDER=stub
# stub | herald
NOTIFICATION_PROVIDER=stub
# stub | claude  (no AI quality adapter is bound yet; "claude" behaves as stub)
QUALITY_PROVIDER=stub
# stub | ai
MODERATION_PROVIDER=stub

# ── MetaMask Embedded Wallets / Web3Auth (WALLET_PROVIDER=web3auth) ───────────
# The web client authenticates here; this API verifies its ES256 identity token
# against the provider JWKS. WEB3AUTH_CLIENT_ID must be the SAME public client id
# as the web app's NEXT_PUBLIC_WEB3AUTH_CLIENT_ID - it is the token audience.
# No client secret is needed for JWKS verification; never add one.
WEB3AUTH_CLIENT_ID=
# WEB3AUTH_JWKS_URL=https://api-auth.web3auth.io/jwks
# WEB3AUTH_TOKEN_ISSUER=https://api-auth.web3auth.io

# ── Privy (legacy reference adapter, WALLET_PROVIDER=privy) ────────────────────
# Not used by the current web client. Leave blank unless deliberately testing it.
# PRIVY_APP_ID=
# PRIVY_APP_SECRET=
# PRIVY_JWKS_URL=https://auth.privy.io/api/v1/apps/<app-id>/jwks.json
# PRIVY_TOKEN_ISSUER=privy.io

# ── Paystack (flat-fee reference adapter, FLATFEE_PROVIDER=paystack) ──────────
# Test keys are `sk_test_...`. PAYSTACK_WEBHOOK_SECRET is the HMAC-SHA512 key
# used to verify `x-paystack-signature` and is required in production; outside
# production the adapter falls back to PAYSTACK_SECRET_KEY. Only boosts reach
# this rail today; there is no application-fee charge route yet (audit F-02).
# PAYSTACK_SECRET_KEY=
# PAYSTACK_WEBHOOK_SECRET=

# ── Didit KYC/AML/KYB (KYC_PROVIDER=didit) ────────────────────────────────────
# Get the API key + webhook secret from business.didit.me -> API Keys / Webhooks.
# Create three workflows: identity only, identity + AML, and business KYB.
# In production the API refuses to boot if KYC_PROVIDER=didit and any of
# DIDIT_API_KEY, DIDIT_WEBHOOK_SECRET, DIDIT_KYC_WORKFLOW_ID,
# DIDIT_KYC_AML_WORKFLOW_ID or DIDIT_KYB_WORKFLOW_ID is blank.
# Leave KYC_PROVIDER=stub to run fully offline.
DIDIT_API_KEY=
# DIDIT_BASE_URL=https://verification.didit.me/v3
# DIDIT_KYC_WORKFLOW_ID=            # identity only (idea-validation VERIFIED tier)
# DIDIT_KYC_AML_WORKFLOW_ID=        # identity + AML (campaign creators / threshold backers)
# DIDIT_KYB_WORKFLOW_ID=            # business KYB (registry + docs + directors/UBOs + AML)
# DIDIT_WEBHOOK_SECRET=             # secret_shared_key; enables signature verification
# Only while rotating DIDIT_WEBHOOK_SECRET (keep for <=24h): verifies `*-Previous` headers.
# DIDIT_WEBHOOK_SECRET_PREVIOUS=
# Where the hosted session returns the user. This MUST be a page that exists on
# the web deployment. The current web app has no `/kyc/callback` route, so this
# is unset by default rather than pointing at a dead local URL.
# DIDIT_CALLBACK_URL=https://inverge.example/d/settings/verification

# ── Verification policy (FR-103 / FR-104) ─────────────────────────────────────
# Bump VERIFICATION_POLICY_VERSION when the checks below change meaning, so
# stored cases record which policy decided them.
# VERIFICATION_POLICY_VERSION=2026-10-27
# A KYB workflow that does not run KYB_KEY_PEOPLE has not checked directors/UBOs.
# DIDIT_KYB_REQUIRE_KEY_PEOPLE=true
# VERIFICATION_RETRY_MAX_PER_DAY=5
# VERIFICATION_RECONCILE_AFTER_MINUTES=15
# VERIFICATION_RECONCILE_INTERVAL_MINUTES=10
# VERIFICATION_RECONCILE_BATCH=25
# VERIFICATION_RECONCILE_MAX_ATTEMPTS=5
# VERIFICATION_AUTHORIZATION_TTL_SECONDS=900

# ── Herald (notifications reference adapter, NOTIFICATION_PROVIDER=herald) ────
# No email/SMTP provider exists in this repository. Herald is an external
# notification gateway; leave blank to keep the stub.
# HERALD_GATEWAY_URL=
# HERALD_API_KEY=

# ── AI classifier (MODERATION_PROVIDER=ai) ────────────────────────────────────
# Anthropic-compatible endpoint. ANTHROPIC_BASE_URL may point at a compatible
# provider (for example DeepSeek). The key is only needed when `ai` is selected;
# the app boots with the stub without it.
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# ANTHROPIC_MODEL=claude-opus-4-8

# ── Solana / escrow ───────────────────────────────────────────────────────────
# Fee-payer sponsorship is a Phase 2 skeleton and does not read this key today
# (`FeePayerService` throws NotImplemented). Do not set it until that path exists.
# FEE_PAYER_SECRET_KEY=
#
# Required only when ESCROW_CHAIN_PROVIDER=solana-rpc; the API refuses to boot
# with the provider on and no URL.
# SOLANA_RPC_URL=https://api.devnet.solana.com
#
# disabled | solana-rpc. `disabled` returns CHAIN_NOT_CONFIGURED (503) instead of
# fabricating a deployment.
# ESCROW_CHAIN_PROVIDER=disabled
# Single-programme allowlist. Must match `declare_id!` in inverge-escrow.
# ESCROW_PROGRAM_ID=38rarxmrSL3rjCN2bwdDfQNLtpYRgLGp96xfkPXv39S1
# devnet | mainnet-beta. mainnet-beta is rejected unless NODE_ENV=production.
# SOLANA_CLUSTER=devnet
# confirmed | finalized. Keep finalized for money paths.
# SOLANA_COMMITMENT=finalized
# JSON map of TokenType -> SPL mint, e.g. {"cNGN":"<mint>"}. Unknown assets are a
# readiness blocker; they never fall back to another mint.
# SOLANA_TOKEN_MINTS=
# Optional override of the per-cluster Circle USDC mint.
# SOLANA_USDC_MINT=
# not_required | flat_fee. `flat_fee` requires a linked SUCCEEDED APPLICATION_FEE
# charge, and no route creates one yet.
# CAMPAIGN_DEPLOYMENT_FEE_MODE=not_required
# CAMPAIGN_DEPLOYMENT_FEE_USD=10

# ── Product analytics (first-party, server-side) ──────────────────────────────
# Retention bounds enforced by the nightly job.
# ANALYTICS_RAW_RETENTION_DAYS=90
# ANALYTICS_AGGREGATE_RETENTION_MONTHS=25
# Service-to-service ingest. Off by default. Enabling it without a >=32-char
# secret fails at boot. The web app must set INVERGE_ANALYTICS_INGEST_SECRET to
# the SAME value.
# ANALYTICS_INGEST_ENABLED=false
# ANALYTICS_INGEST_SECRET=
# ANALYTICS_INGEST_CLOCK_SKEW_SECONDS=300
# ANALYTICS_INGEST_MAX_BODY_BYTES=65536
# Kill switch for every analytics read route (404 when false).
# ANALYTICS_READ_ENABLED=true

# ── Test / CI only ────────────────────────────────────────────────────────────
# REDIS_E2E=true     opts into the Redis-backed e2e suite (test/redis.e2e-spec.ts)
# RUN_LIVE_AI_E2E=true  opts into the live moderation suite (needs ANTHROPIC_API_KEY)
# The e2e harness also forces WALLET_PROVIDER=stub; see test/jest.setup.ts.
