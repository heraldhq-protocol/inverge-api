# ─────────────────────────────────────────────────────────────
# Inverge API — Phase 0 environment
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=3000

# Database (Postgres) — driver-adapter connection string (Prisma v7)
DATABASE_URL=postgresql://inverge:inverge@localhost:5432/inverge?schema=public
# Optional: direct (non-pooled) URL for migrations
DIRECT_URL=postgresql://inverge:inverge@localhost:5432/inverge?schema=public

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# ── Provider selection (vendors are swappable; see docs/phase0-refined-plan.md §3) ──
# Each port picks its adapter by env. "stub" runs fully offline for local dev.
WALLET_PROVIDER=stub          # stub | privy
FLATFEE_PROVIDER=stub         # stub | paystack
KYC_PROVIDER=stub             # stub | smile
NOTIFICATION_PROVIDER=stub    # stub | herald

# ── Privy (embedded wallet reference adapter, FR-101) ──
# Backend verifies Privy access tokens against its JWKS; no vendor SDK required.
PRIVY_APP_ID=
PRIVY_JWKS_URL=https://auth.privy.io/api/v1/apps/PRIVY_APP_ID/jwks.json
PRIVY_TOKEN_ISSUER=privy.io

# ── Paystack (flat-fee reference adapter, FR-206/406) ──
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ── Smile Identity (KYC reference adapter, FR-103–105) — Phase 1 ──
SMILE_PARTNER_ID=
SMILE_API_KEY=

# ── Herald (notifications reference adapter, FR-702) ──
HERALD_GATEWAY_URL=
HERALD_API_KEY=

# ── Fee-payer sponsorship (NFR-10) — skeleton, live at Phase 2 ──
FEE_PAYER_SECRET_KEY=
SOLANA_RPC_URL=https://api.devnet.solana.com

# Session / auth
SESSION_JWT_SECRET=change-me-in-production
