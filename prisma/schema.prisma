// Inverge — Prisma v7 schema
// Phase 0 (idea validation) tables are LIVE. Campaign / escrow / milestone tables
// are present but INERT — schema now, logic in Phase 1/2 (see docs/phase0-refined-plan.md §1).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
  // Connection URLs live in prisma.config.ts (Prisma v7 driver-adapter model).
}

// ─────────────────────────── Enums ───────────────────────────

enum IdeaStatus {
  DRAFT
  VALIDATING
  THRESHOLD_MET
  CONVERTED
  ARCHIVED
}

// FR-272: exposure level. Gate distribution, never existence — a LINK_ONLY idea is
// always reachable by direct URL, just excluded from browse/search/homepage surfaces.
enum DiscoverabilityTier {
  LINK_ONLY
  DISCOVERABLE
  FEATURED
}

// FR-1004: routing outcome of the moderation harness. Auto-rejection is disabled at
// launch (decision D1) — the harness only auto-clears or holds for human review.
enum ModerationDecision {
  AUTO_CLEAR
  HELD_FOR_REVIEW
}

enum SignalType {
  SUPPORT
  PRE_PLEDGE
}

// FR-202/203: creator-built survey question types. RATING answers (1..5) feed the
// idea's feedbackScore; the gate needs at least one RATING question per survey.
enum SurveyQuestionType {
  RATING
  TEXT
  SINGLE_CHOICE
  MULTI_CHOICE
  BOOLEAN
}

// FR-208: verification tier of a pre-pledger, resolved live at recompute time.
// Weight + per-account cap per tier live in PlatformParams (validation.pledgeTiers).
enum VerificationTier {
  EMAIL // email-only, lowest weight + smallest cap (anti-manipulation)
  SOCIAL // unique OAuth social (FR-212); inert until OAuth binding ships
  VERIFIED // KYC-verified or past on-chain funder
}

enum BoostTier {
  BASIC
  FEATURED
}

enum KycStatus {
  NOT_REQUIRED
  PENDING
  VERIFIED
  REJECTED
}

// AML sanctions/PEP/adverse-media screening outcome, tracked separately from identity
// (KYC): a user can be identity-VERIFIED yet AML-FLAGGED. CLEAR is required, in addition
// to KycStatus.VERIFIED, before a user may handle funds (FR-103 creator / FR-104 backer).
enum AmlStatus {
  NOT_SCREENED
  CLEAR
  IN_REVIEW
  FLAGGED
}

// Where an AmlScreening record came from: the AML step embedded in a KYC+AML verification
// session, or a standalone re-screen (admin / ongoing monitoring) via the AML API.
enum AmlScreeningSource {
  KYC_SESSION
  STANDALONE
}

enum WalletRole {
  FUNDING
  PAYOUT
}

// FR-901: platform access tier. ADMIN unlocks the /admin surface (param + boost-price
// config, audit log, user management). Bootstrapped via ADMIN_ALLOWLIST (see env).
enum UserRole {
  USER
  ADMIN
}

enum FlatFeeChargePurpose {
  BOOST
  APPLICATION_FEE
}

enum FlatFeeStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum CreatorTier {
  STARTER
  TRUSTED
  ESTABLISHED
}

enum CampaignType {
  ALL_OR_NOTHING
  FLEXIBLE_FUNDING
}

enum CampaignStatus {
  DRAFT
  IN_REVIEW
  ACTIVE
  FUNDED
  FAILED
  COMPLETED
}

// FR-304: curation state, deliberately separate from the funding lifecycle above.
// APPROVED means "cleared to publish", not "live": publication still has to set the
// escrow, terms hash and launchedAt. Keeping the two axes apart stops an approved but
// unpublished campaign from looking fundable.
enum CampaignReviewStatus {
  NOT_SUBMITTED
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

enum CampaignReviewAction {
  APPROVE
  REQUEST_CHANGES
  REJECT
}

enum ClaimStatus {
  UNDER_REVIEW
  APPROVED
  FAILED
  DISPUTED
}

enum TokenType {
  USDC
  CNGN
}

enum OnChainEventType {
  FUNDED
  TRANCHE_RELEASED
  REFUND_CLAIMED
  MILESTONE_FAILED
}

// ─────────────────────────── Identity ───────────────────────────

model User {
  id             String    @id @default(cuid())
  providerUserId String    @unique // provider-neutral: Web3Auth sub / Privy DID / stub id
  email          String?   @unique
  emailVerified  Boolean   @default(false) // FR-208: EMAIL tier eligibility
  oauthSubject   String?   @unique // FR-212: one social identity ↔ one account (anti-sybil)
  kycStatus      KycStatus @default(NOT_REQUIRED) // FR-103 / FR-104
  kycProviderRef String? // NFR-12: reference only, never raw documents
  amlStatus      AmlStatus @default(NOT_SCREENED) // sanctions/PEP outcome, separate from KYC
  amlScreenedAt  DateTime? // when amlStatus was last set from a screening
  bannedAt       DateTime? // FR-216: banned users' pre-pledges drop out of the weighted figure
  role           UserRole  @default(USER) // FR-901: gates the /admin surface

  // Discovery-feed personalization (onboarding interests). Explicit preferences take
  // precedence; the feed falls back to behaviour (categories/regions of engaged ideas)
  // when these are empty. Bounded multiplier only — never a hard filter (no filter bubble).
  preferredCategories String[] @default([])
  preferredRegions    String[] @default([])
  // Launch trust proxy (e.g. SuperteamNG cohort membership) while delivery history is thin.
  // Admin-settable; feeds the feed TrustScore, never any validation metric.
  institutionalCosign Boolean  @default(false)

  wallets           WalletAccount[]
  creatorProfile    CreatorProfile?
  business          BusinessProfile?
  ideas             Idea[]                @relation("IdeaCreator")
  signals           IdeaSignal[]
  surveyResponses   SurveyResponse[]
  comments          IdeaComment[]
  commentLikes      CommentLike[]
  boostsPurchased   IdeaBoost[]
  kycEvents         KycStatusEvent[]
  amlScreenings     AmlScreening[]
  flatFeeCharges    FlatFeeCharge[]
  campaigns         Campaign[]            @relation("CampaignCreator")
  reviewedCampaigns Campaign[]            @relation("CampaignReviewer")
  campaignReviews   CampaignReviewEvent[] @relation("CampaignReviewActor")
  contributions     Contribution[]
  objections        MilestoneObjection[]
  productAnalyticsEvents ProductAnalyticsEvent[]
  analyticsAccessGrants  AnalyticsAccessGrant[]
  notifications          Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WalletAccount {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  address    String
  provider   String // "privy" (embedded) | "external"
  isEmbedded Boolean    @default(false)
  role       WalletRole @default(FUNDING) // FR-102: funding / payout destination
  createdAt  DateTime   @default(now())

  @@unique([userId, address])
  @@index([address])
}

model KycStatusEvent {
  id          String    @id @default(cuid()) // FR-105 audit trail
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromStatus  KycStatus
  toStatus    KycStatus
  providerRef String?
  businessId  String? // set when the transition is a business (KYB) verification, not personal
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([businessId])
}

// AML screening record (NFR-19: retained 5 years, never hard-deleted by app logic). Stores
// the compliance-relevant outcome + the provider's raw response (hit datasets, risk scores,
// PEP/sanction/adverse-media detail). Not raw KYC documents (NFR-12) — screening evidence.
model AmlScreening {
  id           String             @id @default(cuid())
  userId       String // owner (the account that initiated / owns the screened entity)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId   String? // set for a business (KYB / company) screening; null for individuals
  source       AmlScreeningSource
  status       AmlStatus
  providerRef  String? // Didit request_id / session_id for cross-reference
  totalHits    Int                @default(0)
  topRiskScore Float? // highest risk score among non-false-positive hits
  datasets     String[] // e.g. ["Sanctions","PEP","Adverse Media"]
  raw          Json // full provider response, off-chain (NFR-17/NFR-19)
  createdAt    DateTime           @default(now())

  @@index([userId])
  @@index([businessId])
  @@index([createdAt])
}

// A business/organisation a user registers to run (or back) campaigns as. Verified via
// Didit KYB (registry + documents + directors/UBOs + AML) — one per account. A user is
// funds-eligible as a business on kybStatus VERIFIED + amlStatus CLEAR, independent of any
// personal KYC. Raw KYB detail is never stored here (NFR-12) — only refs + status.
model BusinessProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique // 1:1 owner / representative account
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  legalName          String
  registrationNumber String? // company / registration number
  country            String? // ISO country of registration
  kybStatus          KycStatus @default(NOT_REQUIRED) // reuses the KYC status vocabulary
  amlStatus          AmlStatus @default(NOT_SCREENED) // business AML (sanctions/PEP/adverse media)
  amlScreenedAt      DateTime?
  kybProviderRef     String? // Didit KYB session id
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([kybProviderRef])
}

// FR-306 family — Phase 3 logic, schema present now.
model CreatorProfile {
  userId             String      @id
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier               CreatorTier @default(STARTER)
  username           String?     @unique
  displayName        String?
  avatarUrl          String?
  bio                String?
  links              Json?       @default("[]")
  activeStrikes      Int         @default(0)
  completedCampaigns Int         @default(0)
  lifetimeRaised     Decimal     @default(0) @db.Decimal(14, 2)
  tenureStartedAt    DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

// ─────────────────────────── Discovery taxonomy ───────────────────────────

// Seeded reference data for the shared campaign/idea taxonomy (D-038). The
// canonical list lives in `src/modules/taxonomy/taxonomy.data.ts`, mirrored from
// the web; `prisma/seed.ts` writes these rows and `GET /taxonomy` reads them.
// Assignments on Idea and Campaign are validated at the API boundary and carry no
// foreign key, so an instance can serve while the reference data is reseeded.
model TaxonomyCategory {
  slug          String @id
  label         String
  sortOrder     Int
  subcategories TaxonomySubcategory[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model TaxonomySubcategory {
  categorySlug String
  category     TaxonomyCategory @relation(fields: [categorySlug], references: [slug], onDelete: Cascade)
  slug         String
  label        String
  sortOrder    Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@id([categorySlug, slug])
  @@index([categorySlug, sortOrder])
}

// ─────────────────────────── Idea validation (Phase 0, live) ───────────────────────────

model Idea {
  id        String     @id @default(cuid())
  creatorId String
  creator   User       @relation("IdeaCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  title     String
  slug      String     @unique
  problem   String
  solution  String
  roadmap   String
  askAmount Decimal    @db.Decimal(14, 2)
  status    IdeaStatus @default(DRAFT)

  // FR-270 structured pitch (nullable for back-compat; required at the DTO for new ideas).
  targetUser         String? // who specifically has the problem
  currentAlternative String? // what they do today + why it's insufficient
  askBreakdown       Json? // indicative breakdown of what the ask buys
  roadmapSteps       Json? // >=2 dated steps [{ date, description }]
  category           String? // legacy broad bucket (software | agriculture | ...); new discovery reads taxonomy
  taxonomyCategorySlug    String? // canonical discovery taxonomy (D-038); validated against taxonomy.data.ts
  taxonomySubcategorySlug String? // only meaningful with taxonomyCategorySlug
  region             String? // creator-declared region/origin — personalization + "From Lagos" chip
  coverImageUrl      String? // P1 web UI gap: media on idea
  risks              String? // P2 web UI gap: risks and challenges section
  problemDoc         Json? // Rich text problem document
  solutionDoc        Json? // Rich text solution document

  // FR-271/272 quality & discoverability.
  qualityScore        Decimal?            @db.Decimal(5, 4) // 0..1, latest computed
  qualityScoredAt     DateTime?
  discoverabilityTier DiscoverabilityTier @default(LINK_ONLY)

  // FR-203 public validation metrics — behavioural & unpurchasable.
  // INVARIANT (FR-206a): no boost write path may ever touch these columns.
  supporterCount         Int     @default(0)
  prePledgeTotal         Decimal @default(0) @db.Decimal(14, 2) // raw USD sum (internal/audit)
  // FR-207: the public "Estimated interest" figure — Σ min(amountUsd, tierCap) × tierWeight.
  weightedPrePledgeTotal Decimal @default(0) @db.Decimal(14, 2)
  feedbackScore          Decimal @default(0) @db.Decimal(5, 2)
  feedbackCount          Int     @default(0)
  commentCount           Int     @default(0) // engagement volume from the comments thread (FR-273)

  // Aggregate discovery-feed exposure. Drives the UCB exploration bonus (rich-get-richer
  // fix): items seen less get a larger bonus that shrinks as exposure accrues. NOT a
  // validation metric — never touched by boosts, never public.
  feedImpressions Int @default(0)

  // FR-204: creator-declared expected pre-pledge minimum; the gate uses max(platform floor, this).
  creatorPrePledgeTarget Decimal?  @db.Decimal(14, 2)
  // FR-204a: validation window / sustainment.
  validatingSince        DateTime? // set when DRAFT → VALIDATING
  windowRenewedAt        DateTime? // window is renewable once

  signals         IdeaSignal[]
  surveyQuestions SurveyQuestion[]
  surveyResponses SurveyResponse[]
  comments        IdeaComment[]
  boosts          IdeaBoost[]
  campaign        Campaign?
  metricSnapshots IdeaMetricSnapshot[]
  qualityReports  IdeaQualityReport[]
  moderationCases ModerationCase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([taxonomyCategorySlug, taxonomySubcategorySlug, createdAt(sort: Desc), id(sort: Desc)])
}

// FR-271: audit + coaching output of each quality scoring run (on publish and edit).
model IdeaQualityReport {
  id         String   @id @default(cuid())
  ideaId     String
  idea       Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  score      Decimal  @db.Decimal(5, 4) // 0..1
  checks     Json // [{ id, passed, severity, message, kind: 'deterministic'|'ai' }]
  computedAt DateTime @default(now())

  @@index([ideaId, computedAt])
}

// FR-1006/1012: recorded outcome of one moderation-harness run. Dual reason fields
// (internal = full detail; external = creator-facing, generic for AML per D2/FR-1007).
// Retained per NFR-19 (5-year AML record retention) — never hard-deleted by app logic.
model ModerationCase {
  id             String             @id @default(cuid())
  kind           String // 'idea' | 'campaign'
  ideaId         String?
  idea           Idea?              @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  submittedById  String? // acting/submitting user
  decision       ModerationDecision
  maxRisk        Decimal            @db.Decimal(5, 4)
  categories     Json // [{ code, riskScore, excerpt, draftReason }]
  reasonCodes    String[] // FR-1006: >=1 policy reason code
  internalReason String // full rationale (audit + compliance only)
  externalReason String // creator-facing (generic when POL-AML contributes)
  brief          String // FR-1005 pre-review brief for the admin queue
  provider       String // classifier provenance ('stub' | 'ai:<model>')
  policyVersion  String // FR-1001: taxonomy version in force
  createdAt      DateTime           @default(now())

  @@index([decision, createdAt])
  @@index([ideaId])
}

// FR-204a: daily snapshot of the weighted figure, so the graduation gate can require
// the threshold be SUSTAINED (held N consecutive days / at window close), not just touched.
model IdeaMetricSnapshot {
  id             String   @id @default(cuid())
  ideaId         String
  idea           Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  capturedAt     DateTime @default(now())
  weightedTotal  Decimal  @db.Decimal(14, 2)
  supporterCount Int

  @@index([ideaId, capturedAt])
}

// FR-202: support or pre-pledge intent; NO funds move.
model IdeaSignal {
  id        String     @id @default(cuid())
  ideaId    String
  idea      Idea       @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      SignalType
  amount    Decimal?   @db.Decimal(14, 2) // set only for PRE_PLEDGE — stated amount, original currency
  currency  String     @default("USD") // FR-210: USD default; NGN accepted and normalized
  amountUsd Decimal?   @db.Decimal(14, 2) // FR-210: stated amount normalized to USD (drives weighting)
  createdAt DateTime   @default(now())

  @@unique([ideaId, userId, type])
  @@index([ideaId])
  @@index([userId, createdAt(sort: Desc)])
}

// FR-202/203: a creator-built survey question. Ordered per idea; choice types carry
// their options. Editable while the survey is being built; responses reference by id.
model SurveyQuestion {
  id        String             @id @default(cuid())
  ideaId    String
  idea      Idea               @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  index     Int // display order
  prompt    String
  type      SurveyQuestionType
  options   Json? // string[] for SINGLE_CHOICE / MULTI_CHOICE
  required  Boolean            @default(true)
  createdAt DateTime           @default(now())

  @@unique([ideaId, index])
  @@index([ideaId])
}

// FR-202/203: one backer's survey submission (one per idea+user). `answers` is
// [{ questionId, value }]; RATING values (1..5) drive feedbackScore, response count
// drives feedbackCount. Recomputed server-side on write (no boost path touches it).
model SurveyResponse {
  id        String   @id @default(cuid())
  ideaId    String
  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers   Json // [{ questionId, value }]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ideaId, userId])
  @@index([ideaId])
}

// Free-form comments thread on an idea (distinct from the structured survey). Comments
// can be liked and replied to (self-relation); a creator can highlight standout comments.
model IdeaComment {
  id          String        @id @default(cuid())
  ideaId      String
  idea        Idea          @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  body        String
  highlighted Boolean       @default(false)
  parentId    String? // reply target (null = top-level)
  parent      IdeaComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     IdeaComment[] @relation("CommentReplies")
  likes       CommentLike[]
  likeCount   Int           @default(0)
  createdAt   DateTime      @default(now())

  @@index([ideaId, createdAt])
  @@index([parentId])
}

// One like per (comment, user).
model CommentLike {
  id        String      @id @default(cuid())
  commentId String
  comment   IdeaComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([commentId, userId])
  @@index([commentId])
}

// FR-206 / FR-206a: paid placement. Separate table from signals/feedback by design —
// this is how "boosts never touch validation metrics" is enforced structurally.
model IdeaBoost {
  id                String        @id @default(cuid())
  ideaId            String
  idea              Idea          @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  purchasedByUserId String
  purchasedBy       User          @relation(fields: [purchasedByUserId], references: [id], onDelete: Cascade)
  tier              BoostTier
  flatFeeChargeId   String        @unique
  flatFeeCharge     FlatFeeCharge @relation(fields: [flatFeeChargeId], references: [id])
  startsAt          DateTime
  endsAt            DateTime?
  createdAt         DateTime      @default(now())

  @@index([ideaId])
}

// FR-406: flat-fee rail, separate from the on/off-ramp escrow flow.
model FlatFeeCharge {
  id           String               @id @default(cuid())
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose      FlatFeeChargePurpose
  amount       Decimal              @db.Decimal(10, 2)
  currency     String               @default("NGN")
  processorRef String               @unique
  status       FlatFeeStatus        @default(PENDING)
  metadata     Json? // carries e.g. { ideaId, tier } so the webhook can fulfil without a back-dependency
  boost        IdeaBoost?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([userId])
}

// ─────────────────────────── Campaigns & escrow (INERT: schema now, logic Phase 1/2) ───────────────────────────

model Campaign {
  id                       String         @id @default(cuid())
  ideaId                   String?        @unique
  idea                     Idea?          @relation(fields: [ideaId], references: [id])
  ideaSnapshot             Json?
  taxonomyCategorySlug     String? // copied from the idea at conversion; validated at the API boundary
  taxonomySubcategorySlug  String?
  creatorId                String
  creator                  User           @relation("CampaignCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  type                     CampaignType   @default(ALL_OR_NOTHING)
  status                   CampaignStatus @default(DRAFT)
  tokenType                TokenType
  targetAmount             Decimal        @db.Decimal(14, 2)
  fundingFloorPct          Int? // Flexible Funding only (FR-306)
  deadline                 DateTime
  termsHash                String? // FR-303: content hash, stored on-chain once published
  workingCapitalPct        Decimal        @default(0) @db.Decimal(5, 2) // FR-503a: capped 20–25%
  workingCapitalReleasedAt DateTime?
  escrowPdaAddress         String?
  totalRaised              Decimal        @default(0) @db.Decimal(14, 2)
  applicationFeeChargeId   String?        @unique // FR-311 gate: one paid application fee per campaign
  videoUrl                 String? // P1 item 16: campaign media (required to publish)
  videoPosterUrl           String?
  coverImageUrl            String?
  rewardTiers              Json? // P1 item 19: optional reward tiers

  // FR-304 curation state. The funding lifecycle stays in `status`; approving here
  // does not publish or fund the campaign.
  reviewStatus CampaignReviewStatus  @default(NOT_SUBMITTED)
  submittedAt  DateTime?
  reviewReason String?
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?                 @relation("CampaignReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewEvents CampaignReviewEvent[]

  milestones    Milestone[]
  contributions Contribution[]
  onChainEvents OnChainEvent[]

  createdAt  DateTime  @default(now())
  launchedAt DateTime?
  updatedAt  DateTime  @updatedAt

  @@index([creatorId])
  @@index([status])
  @@index([reviewStatus, submittedAt])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([deadline, id])
  @@index([totalRaised(sort: Desc), id(sort: Desc)])
  @@index([taxonomyCategorySlug, taxonomySubcategorySlug, createdAt(sort: Desc), id(sort: Desc)])
}

// FR-304 / FR-904: append-only record of every curation decision. Application code
// never updates or deletes these rows; Campaign.reviewStatus projects the latest one.
// Restrict on the actor keeps an admin attributable for as long as the trail exists.
model CampaignReviewEvent {
  id         String               @id @default(cuid())
  campaignId String
  campaign   Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  actorId    String
  actor      User                 @relation("CampaignReviewActor", fields: [actorId], references: [id], onDelete: Restrict)
  action     CampaignReviewAction
  fromStatus CampaignReviewStatus
  toStatus   CampaignReviewStatus
  reason     String?
  createdAt  DateTime             @default(now())

  @@index([campaignId, createdAt])
  @@index([createdAt])
}

model Milestone {
  id                 String   @id @default(cuid())
  campaignId         String
  campaign           Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  index              Int
  title              String
  deliverable        String   @default("")
  tranchePct         Decimal  @db.Decimal(5, 2) // FR-302: sums to 100
  evidenceDefinition Json // FR-302: proof type + source, immutable once published

  claims MilestoneClaim[]

  @@unique([campaignId, index])
}

model MilestoneClaim {
  id                    String      @id @default(cuid())
  milestoneId           String
  milestone             Milestone   @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  proofBundle           Json
  submittedAt           DateTime    @default(now())
  objectionWindowEndsAt DateTime // default +7 days (FR-602)
  status                ClaimStatus @default(UNDER_REVIEW)

  objections MilestoneObjection[]
  ruling     ReviewerRuling?

  @@index([milestoneId, submittedAt(sort: Desc)])
}

model MilestoneObjection {
  id        String         @id @default(cuid())
  claimId   String
  claim     MilestoneClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String
  weightPct Decimal        @db.Decimal(5, 2) // FR-604: capped, default 15%
  createdAt DateTime       @default(now())

  @@unique([claimId, userId])
}

model ReviewerRuling {
  id          String         @id @default(cuid())
  claimId     String         @unique
  claim       MilestoneClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  decision    String // "UPHELD_OBJECTION" | "OVERTURNED"
  reasoning   String
  txSignature String?
  ruledAt     DateTime       @default(now())
}

model Contribution {
  id          String    @id @default(cuid())
  campaignId  String
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Decimal   @db.Decimal(14, 2)
  tokenType   TokenType
  txSignature String    @unique
  createdAt   DateTime  @default(now())

  @@index([campaignId, createdAt(sort: Desc)])
  @@index([userId])
}

// FR-803: transparency dashboard reads ONLY from here. Written exclusively by the
// indexer job (Phase 2) — never by application business logic.
model OnChainEvent {
  id          String           @id @default(cuid())
  campaignId  String
  campaign    Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  eventType   OnChainEventType
  amount      Decimal?         @db.Decimal(14, 2)
  txSignature String           @unique
  blockTime   DateTime
  indexedAt   DateTime         @default(now())

  @@index([campaignId, eventType, blockTime(sort: Desc)])
}

// FR-901 / FR-904: admin-configurable platform parameters (fees, thresholds, windows).
model PlatformParam {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// FR-904: append-only audit trail of every platform-param change (who, when, old -> new).
// Written on each effective change; the PlatformParam row keeps only the latest value.
model PlatformParamAudit {
  id        String   @id @default(cuid())
  key       String
  oldValue  Json? // null on first-ever set
  newValue  Json
  changedBy String? // acting user id
  changedAt DateTime @default(now())

  @@index([key, changedAt])
  @@index([changedAt])
}

// ---------------------------------------------------------------------------
// Product analytics (first-party, aggregate-only; see docs/api/analytics-privacy.md)
//
// No IP, user agent, cookie, fingerprint, free text or wallet address is stored.
// Authenticated events carry the internal user id; anonymous events carry only a
// session-scoped random id. Raw events are retained 90 days; daily aggregates 25
// months. There is no public browser ingest route. Views arrive through a signed
// service-to-service route; confirmed domain events are written after their own
// transaction commits. A failed analytics write never fails the user action.
// ---------------------------------------------------------------------------

enum ProductAnalyticsEventName {
  PAGE_VIEWED
  IDEA_VIEWED
  IDEA_SIGNAL
  FEEDBACK_SUBMITTED
  CAMPAIGN_VIEWED
  CAMPAIGN_STEP_STARTED
  CAMPAIGN_STEP_COMPLETED
  CONTRIBUTION_STARTED
  CONTRIBUTION_CONFIRMED
  SEARCH_PERFORMED
}

enum AnalyticsSignalType {
  SUPPORT
  PRE_PLEDGE
}

// The closed resource vocabulary. A generic type/id pair lets one reach pipeline
// serve ideas, campaigns and fixed page keys without a nullable column per surface.
enum AnalyticsResourceType {
  IDEA
  CAMPAIGN
  PAGE
}

model ProductAnalyticsEvent {
  id            String                    @id @default(cuid())
  eventKey      String                    @unique // caller idempotency key; domain rows use their own id
  schemaVersion Int                       @default(1)
  name          ProductAnalyticsEventName
  userId        String? // internal id only; never an email, wallet or provider subject
  user          User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId     String? // anonymous, session-scoped random id; mutually exclusive with userId
  ideaId        String?
  campaignId    String?
  resourceType  AnalyticsResourceType?
  resourceId    String? // idea/campaign id, or a closed page key
  signalType    AnalyticsSignalType?
  source        String? // feed | search | direct | internal, from a closed set validated in code
  position      Int?
  step          String? // creator-flow step, from a closed set validated in code
  durationMs    Int?
  queryLength   Int?
  resultCount   Int?
  filterKeys    String[] @default([])
  amountMinor   BigInt?
  currency      String?
  countryCode   String?  @db.Char(2) // coarse, from a trusted edge header only
  occurredAt    DateTime
  receivedAt    DateTime @default(now())

  @@index([name, occurredAt])
  @@index([ideaId, name, occurredAt])
  @@index([campaignId, name, occurredAt])
  @@index([resourceType, resourceId, name, occurredAt])
  @@index([resourceType, resourceId, source, occurredAt])
  @@index([userId, occurredAt])
  @@index([receivedAt])
}

// Daily roll-up of idea signals. Derived only from ProductAnalyticsEvent; rebuilt
// idempotently per (ideaId, day), never incremented by a request path.
model IdeaSignalDailyMetric {
  id              String   @id @default(cuid())
  ideaId          String
  day             DateTime @db.Date
  supportCount    Int      @default(0)
  prePledgeCount  Int      @default(0)
  uniqueActors    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([ideaId, day])
  @@index([day])
}

// Reach roll-up: one row per resource per UTC day. Rebuilt from raw events, so a
// rerun replaces the day's counts. `uniqueSessions` is distinct by userId when
// signed in, otherwise by the anonymous session id; a missing actor is not counted.
model ResourceReachDailyMetric {
  id             String                @id @default(cuid())
  resourceType   AnalyticsResourceType
  resourceId     String
  day            DateTime              @db.Date
  views          Int                   @default(0)
  uniqueSessions Int                   @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([resourceType, resourceId, day])
  @@index([day])
  @@index([resourceType, day])
}

// Acquisition roll-up by the closed source vocabulary. A missing source is stored
// as `direct`; no referrer URL or query string is ever written.
model ResourceAcquisitionDailyMetric {
  id             String                @id @default(cuid())
  resourceType   AnalyticsResourceType
  resourceId     String
  day            DateTime              @db.Date
  source         String
  views          Int                   @default(0)
  uniqueSessions Int                   @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([resourceType, resourceId, day, source])
  @@index([day])
  @@index([resourceType, day])
}

// Country roll-up from the trusted edge header. The IP is discarded before the
// event is written; unknown countries are excluded rather than stored as a guess.
model ResourceCountryDailyMetric {
  id             String                @id @default(cuid())
  resourceType   AnalyticsResourceType
  resourceId     String
  day            DateTime              @db.Date
  countryCode    String                @db.Char(2)
  views          Int                   @default(0)
  uniqueSessions Int                   @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([resourceType, resourceId, day, countryCode])
  @@index([day])
  @@index([resourceType, day])
}

// Creator-flow funnel roll-up. Views and unique sessions live in the reach table;
// this table stores only the step and backing-start counts so the two cannot drift.
model CampaignFunnelDailyMetric {
  id                  String   @id @default(cuid())
  campaignId          String
  day                 DateTime @db.Date
  stepStarted         Int      @default(0)
  stepCompleted       Int      @default(0)
  contributionStarted Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([campaignId, day])
  @@index([day])
}

// Premium analytics access. Collection is free; the richer reports are gated by an
// explicit grant so the same row can later be issued by a paid checkout without a
// schema change. `feature` is a closed code (`analytics.premium`), not user text.
enum AnalyticsAccessStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AnalyticsAccessSource {
  REQUEST
  ADMIN
  PAID
}

model AnalyticsAccessGrant {
  id                String                @id @default(cuid())
  userId            String
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature           String                @default("analytics.premium")
  status            AnalyticsAccessStatus @default(PENDING)
  source            AnalyticsAccessSource @default(REQUEST)
  requestedAt       DateTime              @default(now())
  decidedAt         DateTime?
  decidedBy         String? // admin user id; no relation so the audit row survives an admin deletion
  expiresAt         DateTime? // null = no expiry; a paid grant sets the paid-through instant
  externalReference String?               @db.VarChar(128) // future payment reference; never raw card data
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([userId, feature])
  @@index([status, requestedAt])
}

// ---------------------------------------------------------------------------
// Advertising (PROPOSED - schema only, no Nest module, migration not applied)
//
// A paid placement is a separate bounded context. It has no relation to Idea,
// Campaign, IdeaSignal, or Contribution, so it cannot write ranking, validation,
// or funding state. Placement ids are the closed set documented in
// docs/api/advertising.md; the API validates them before insert.
// ---------------------------------------------------------------------------

enum AdCreativeStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  PAUSED
  ENDED
}

enum AdCreativeKind {
  FIRST_PARTY
  THIRD_PARTY
}

enum AdCreativeFormat {
  NATIVE_CARD
  BANNER
  SIDEBAR
  THIRD_PARTY
}

enum AdReviewAction {
  SUBMIT
  APPROVE
  REJECT
  PAUSE
  RESUME
  END
}

enum AdEventType {
  AD_IMPRESSION
  AD_CLICK
  AD_DISMISS
  AD_DESTINATION_OPENED
}

// The creative. `approved` is permission to serve, not a schedule: serving also
// requires startsAt <= now < endsAt and the placement relation.
model Advertisement {
  id              String            @id @default(cuid())
  advertiser      String
  headline        String
  body            String
  ctaLabel        String
  destination     String
  format          AdCreativeFormat
  kind            AdCreativeKind    @default(FIRST_PARTY)
  status          AdCreativeStatus  @default(DRAFT)
  priority        Int               @default(0)
  startsAt        DateTime
  endsAt          DateTime
  categories      String[]          @default([])
  regions         String[]          @default([])
  createdById     String
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  placements AdvertisementPlacement[]
  reviews    AdvertisementReviewEvent[]

  @@index([status, startsAt, endsAt])
  @@index([kind, status])
}

// One row per allowed placement. @@unique makes a duplicate booking impossible.
model AdvertisementPlacement {
  id              String        @id @default(cuid())
  advertisementId String
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  placementId     String

  @@unique([advertisementId, placementId])
  @@index([placementId])
}

// Append-only review trail. actorId is not an FK for the same reason as
// PlatformParamAudit.changedBy: the trail must survive an account deletion.
model AdvertisementReviewEvent {
  id              String            @id @default(cuid())
  advertisementId String
  advertisement   Advertisement     @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  actorId         String
  action          AdReviewAction
  fromStatus      AdCreativeStatus
  toStatus        AdCreativeStatus
  reason          String?
  createdAt       DateTime          @default(now())

  @@index([advertisementId, createdAt])
  @@index([createdAt])
}

// Validated measurement events. No IP address, user agent, cookie, account, or
// free text. `dedupeKey` closes the client retry gap. Raw rows are retained for
// 90 days, then only daily aggregates remain (see analytics-privacy.md).
model AdvertisementEvent {
  id          String       @id @default(cuid())
  creativeId  String
  placementId String
  type        AdEventType
  sessionId   String
  dedupeKey   String       @unique
  occurredAt  DateTime
  receivedAt  DateTime     @default(now())

  @@index([creativeId, occurredAt])
  @@index([placementId, occurredAt])
  @@index([receivedAt])
}

// Persisted in-app notification. The row is the durable record; delivery to an
// external channel is a separate, retryable step. `dedupeKey` makes a repeated
// domain event (for example a replayed campaign conversion) idempotent.
model Notification {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  template         String
  data             Json?
  dedupeKey        String?   @unique
  readAt           DateTime?
  dispatchedAt     DateTime?
  dispatchAttempts Int       @default(0)
  lastDispatchError String?
  createdAt        DateTime  @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
}

// Durable receipt for a verified provider callback. The raw body is never stored:
// only a hash plus the normalized event type and minimum routing metadata. A
// duplicate retry returns without reapplying; a failed event can be retried.
enum WebhookProvider {
  PAYSTACK
  DIDIT
}

enum WebhookReceiptStatus {
  PENDING
  PROCESSING
  PROCESSED
  IGNORED
  FAILED
}

model WebhookReceipt {
  id          String               @id @default(cuid())
  provider    WebhookProvider
  dedupeKey   String
  payloadHash String
  eventType   String?
  status      WebhookReceiptStatus @default(PENDING)
  attempts    Int                  @default(0)
  receivedAt  DateTime             @default(now())
  processedAt DateTime?
  lockedAt    DateTime?
  lastError   String?

  @@unique([provider, dedupeKey])
  @@index([provider, receivedAt])
  @@index([status, lockedAt])
}
