# ─────────────────────────────────────────────────────────────
# Inverge API — STAGING template
#
# This is a committed TEMPLATE. It contains no real values.
# Generate the local, gitignored staging file with:
#
#     node scripts/init-staging-env.mjs
#
# That writes `inverge-api/.env.staging` and `inverge-web/.env.staging.local`,
# minting the application-owned secrets once and sharing the analytics HMAC
# between both services. Then replace every `__TODO_*__` marker with the value
# from the provider dashboard. Never commit the generated files.
#
# Posture: NODE_ENV=production on Render, real Web3Auth + Didit test
# credentials, Devnet. This is deliberate: `NODE_ENV=development` would relax
# production checks and is not a usable staging mode (audit F-01).
# ─────────────────────────────────────────────────────────────

# ── App ────────────────────────────────────────────────────────
NODE_ENV=production
# Render injects PORT. Leave this line out on Render.
PORT=10000

# ── Database ───────────────────────────────────────────────────
# Render Postgres -> "Internal Database URL" for a service in the same region.
# Replace before the first boot: the process will not start without a valid URL.
DATABASE_URL=__TODO_RENDER_POSTGRES_INTERNAL_URL__
# Only needed if the database sits behind a pooler.
# DIRECT_URL=

# ── Redis / BullMQ ─────────────────────────────────────────────
# Render Redis -> "Internal Redis URL". Replace before the first boot.
REDIS_URL=__TODO_RENDER_REDIS_INTERNAL_URL__
REDIS_ENABLED=true
QUEUE_ENABLED=true

# ── HTTP / proxy ───────────────────────────────────────────────
# Empty is correct for a web-only deployment: the Next.js server calls this API
# server-to-server, so no browser origin needs CORS. Add an origin only for a
# browser or native client that calls the API directly.
CORS_ORIGINS=
# Render terminates TLS in front of the service.
TRUST_PROXY_HOPS=1
JSON_BODY_LIMIT=1mb

# ── Rate limiting, metrics, logs ───────────────────────────────
RATE_LIMIT_ENABLED=true
METRICS_ENABLED=true
# Generated by the init script. Without it /metrics is public.
METRICS_TOKEN=__GENERATE_METRICS_TOKEN__
LOG_FORMAT=json
LOG_LEVEL=log
# Generated by the init script.
LOG_HASH_SALT=__GENERATE_LOG_SALT__

# ── Session / auth ─────────────────────────────────────────────
# Generated by the init script. Unique to staging; never reuse production's.
SESSION_JWT_SECRET=__GENERATE_SESSION_SECRET__

# Bootstrap admin(s): comma-separated emails and/or provider user ids.
# Replace with the operator who will approve KYC/campaigns in staging.
ADMIN_ALLOWLIST=__TODO_OPERATOR_EMAIL_OR_PROVIDER_ID__

# ── Provider selection ─────────────────────────────────────────
WALLET_PROVIDER=web3auth
FLATFEE_PROVIDER=paystack
KYC_PROVIDER=didit
NOTIFICATION_PROVIDER=stub
QUALITY_PROVIDER=stub
MODERATION_PROVIDER=stub

# ── Web3Auth / MetaMask Embedded Wallets ───────────────────────
# Staging decision, pick one:
#   a) a separate Web3Auth project for staging (recommended: separate wallets), or
#   b) the same project, with the staging web origin allowlisted in the dashboard.
# Either way this MUST equal the web's NEXT_PUBLIC_WEB3AUTH_CLIENT_ID.
WEB3AUTH_CLIENT_ID=
# Keep the defaults unless the dashboard says otherwise.
# WEB3AUTH_JWKS_URL=https://api-auth.web3auth.io/jwks
# WEB3AUTH_TOKEN_ISSUER=https://api-auth.web3auth.io

# ── Paystack (test mode) ───────────────────────────────────────
# Use a TEST key: sk_test_... Never paste a live key into staging.
# Only boosts reach this rail today; applications fee charging is unimplemented.
# NODE_ENV=production refuses FLATFEE_PROVIDER=stub (audit F-01), so a test key is
# required before staging boots. Do not work around this by relaxing NODE_ENV.
PAYSTACK_SECRET_KEY=
# Dashboard -> Webhooks. Required in production; the API refuses to boot without it.
PAYSTACK_WEBHOOK_SECRET=

# ── Didit (staging workflows) ──────────────────────────────────
# Create three workflows in the Didit dashboard for staging:
#   identity only, identity + AML, business KYB.
# With NODE_ENV=production the API REFUSES TO BOOT until every value below is
# non-empty. That is intentional; do not work around it with fake strings.
DIDIT_API_KEY=
DIDIT_KYC_WORKFLOW_ID=
DIDIT_KYC_AML_WORKFLOW_ID=
DIDIT_KYB_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
# DIDIT_BASE_URL=https://verification.didit.me/v3
# DIDIT_WEBHOOK_SECRET_PREVIOUS=

# Return URL after the hosted session. MUST be a page that exists on the staging
# web deployment. Replace the host with the real staging domain before testing.
DIDIT_CALLBACK_URL=https://staging.inverge.example/d/settings/verification

# ── Verification policy ────────────────────────────────────────
VERIFICATION_POLICY_VERSION=2026-10-27
DIDIT_KYB_REQUIRE_KEY_PEOPLE=true
VERIFICATION_RETRY_MAX_PER_DAY=5
VERIFICATION_RECONCILE_AFTER_MINUTES=15
VERIFICATION_RECONCILE_INTERVAL_MINUTES=10
VERIFICATION_RECONCILE_BATCH=25
VERIFICATION_RECONCILE_MAX_ATTEMPTS=5
VERIFICATION_AUTHORIZATION_TTL_SECONDS=900

# ── Notifications / AI ─────────────────────────────────────────
# No email provider exists; Herald is an external gateway. Leave on stub.
# HERALD_GATEWAY_URL=
# HERALD_API_KEY=
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# ANTHROPIC_MODEL=claude-opus-4-8

# ── Solana / escrow ────────────────────────────────────────────
# Devnet only. Mainnet is refused unless NODE_ENV=production, and must not be
# used for staging regardless.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet
SOLANA_COMMITMENT=finalized
# Keep disabled until the programme is actually deployed to Devnet and the
# programme-id/keypair mismatch is resolved (see deployment report §10). Turning
# this on with an undeployed programme only produces 503s.
ESCROW_CHAIN_PROVIDER=disabled
ESCROW_PROGRAM_ID=38rarxmrSL3rjCN2bwdDfQNLtpYRgLGp96xfkPXv39S1
# SOLANA_TOKEN_MINTS=
# SOLANA_USDC_MINT=
CAMPAIGN_DEPLOYMENT_FEE_MODE=not_required
CAMPAIGN_DEPLOYMENT_FEE_USD=10

# ── Product analytics ──────────────────────────────────────────
ANALYTICS_RAW_RETENTION_DAYS=90
ANALYTICS_AGGREGATE_RETENTION_MONTHS=25
ANALYTICS_INGEST_ENABLED=true
# Generated by the init script; the web staging file receives the same value.
ANALYTICS_INGEST_SECRET=__GENERATE_ANALYTICS_SECRET__
ANALYTICS_INGEST_CLOCK_SKEW_SECONDS=300
ANALYTICS_INGEST_MAX_BODY_BYTES=65536
ANALYTICS_READ_ENABLED=true
