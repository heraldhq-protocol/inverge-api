# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/

# Prisma generated client (prisma-client generator, regenerated on install)
src/generated/

# Env — real values only ever live in an untracked file.
# Staging templates are committed (*.example); generated staging files are not.
.env
.env.*
!.env.example
!.env.*.example

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Test / coverage
coverage/
.nyc_output/

# Misc
*.tsbuildinfo

# Local runtime artefacts. The stub email adapter writes rendered messages
# (including verification codes) here; it must never be committed.
.local/

# Local dev/probe helpers (root-level, excluded from build via tsconfig.build.json)
/_*.ts
